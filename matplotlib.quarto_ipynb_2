        "## Gráficos\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Iniciamos importando o Matplotlib\n",
        "import matplotlib.pyplot as pl\n",
        "import numpy as np\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Vamos criar dois arrays para servirem de dados ficticios\n",
        "x = np.arange(0, 100, 10)\n",
        "y = 5*x + 10\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "print(x)\n",
        "print(y)\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Podemos fazer um plot de maneira imediada\n",
        "pl.plot(x, y)\n",
        "pl.show()\n",
        "```"
      ],
      "id": "32650a47"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: true\n",
        "# Existem diferentes argumentos e Kwargs que podemos utilizar para modificar nossos plots\n",
        "pl.plot?"
      ],
