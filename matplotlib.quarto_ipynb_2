      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Por exemplo\n",
        "\n",
        "pl.figure(figsize=[10, 3]) # Podemos definir as dimensões das figuras\n",
        "\n",
        "pl.plot(x, y, '^-', linewidth=3, color='blue') # as cores de cada plot, largura de linha, simbolos utilizados, etc\n",
        "pl.plot(x, 2*x + 5, '>:', lw=0.5, color='indigo')\n",
        "pl.plot(x, -2*x + 300, '<--', color='silver')\n",
        "pl.text(50, 300, 'Teste', fontsize=20, color='blue') # Podemos plotar texto\n",
        "pl.grid(False)\n",
        "\n",
        "pl.xlim(30, 60) # Definir os limites dos plots (em x)\n",
        "pl.ylim(100, 400) # Definir os limites dos plots (em y)\n",
        "\n",
        "pl.xlabel('Valores X', fontsize=15) # Definir os labels (em x)\n",
        "pl.ylabel(r'Valores $\\Delta$ [km]', fontsize=15) # Definir os labels (em y)\n",
        "\n",
        "pl.xticks(np.array([35, 45, 55]),fontsize=15, rotation=-60) # Definir os ticks, (em x) suas posições, valores, e parâmetros\n",
        "pl.yticks(np.array([150, 250, 350]),fontsize=15, rotation=0) # Definir os ticks, (em x) suas posições, valores, e parâmetros\n",
        "\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Vamos criar um outro conjunto de dados, desta vez randomicos\n",
        "a = np.random.randint(0, 300, 10)\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "pl.bar(x, a, width=8) # Criando gráficos de barra\n",
        "pl.plot(x, a, color='red', lw=1, marker='*')\n",
        "#pl.xlim(15, 85)\n",
        "#pl.ylim(200, 300)\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "pl.barh(x, a, height=8) # Barras horizontais\n",
        "pl.plot(a, x, color='red', lw=1, marker='*')\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "pl.step(x, a) # Plots Steps\n",
        "pl.show()\n",
        "```"
