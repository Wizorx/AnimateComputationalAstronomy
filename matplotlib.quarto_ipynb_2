      "source": [
        "```{pyodide}\n",
        "#| autorun: true\n",
        "pl.stem(x, a, markerfmt ='yo', basefmt='g.', linefmt='blue') # Plots stem\n",
        "pl.stem(x, y, markerfmt ='ro', basefmt='g.', linefmt='blue')\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Criando novos conjuntos de dados\n",
        "y2 = np.random.normal(0, 1, 100)\n",
        "y3 = np.random.normal(0, 1, 100)\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "pl.figure(figsize=[15,3])\n",
        "pl.plot(y2, '+', color='gray', alpha=1.0) # Outro parâmetro importante é o alpha, que controla trsnaparencia, 0 = transparente, 1.0 = opaco\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Outro exemplo de transparência\n",
        "\n",
        "pl.hist(y2, np.arange(-4, +4.5, 0.5), color='blue')\n",
        "pl.hist(y3, np.arange(-4, +4.5, 0.5), color='red', alpha=0.5) \n",
        "pl.axvline(0, color='k')\n",
        "pl.axvline(+1, color='gray')\n",
        "pl.axvline(-1, color='gray')\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "pl.plot(y2)\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Criando gráficos com barra de erros\n",
        "pl.errorbar(x, y, yerr=a, xerr=2, linestyle='', marker='.', ecolor='red', color='k')\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "y2 = 2*y\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Pintando uma região, utilizando o fill_between\n",
        "pl.plot(x, y, color='k')\n",
        "pl.fill_between(x, a, 2*a, alpha=0.5)\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Podemos utilizar o label para definir as legendas de cada elemento\n",
        "pl.plot(x, y, color='k', label='Area')\n",
        "pl.fill_between(x, a, 2*a, alpha=0.5, label='Reta')\n",
        "\n",
        "pl.legend(fontsize=15, loc=4) # podemos definir o tamanho e localização da legenda\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Podemos também criar linhas retas (horizontais e na vertical)\n",
        "\n",
        "pl.plot(x, y, color='k', label='Area')\n",
        "pl.fill_between(x, a, 2*a, alpha=0.5, label='Reta')\n",
        "\n",
        "pl.axhline(400, color='red', label=r'$\\chi^2$') # horizontal\n",
        "pl.axvline(60, color='blue', linestyle='--', label=r'$Bla^2$') # vertical \n",
        "\n",
        "pl.legend(fontsize=15, loc=4)\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Aqui podemos, ilustrar diferentes tamanhos, e diferentes cores para cada ponto  \n",
        "pl.scatter(x, y, s=a, c=2*a, cmap='cividis')\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Podemos também criar gráficos de Pizza\n",
        "x2 = np.array([15, 10 , 30])\n",
        "\n",
        "pl.pie(x2)\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Plotando matrizes (imagens!)\n",
        "\n",
        "x, y = np.meshgrid(np.arange(1000), np.arange(1000))\n",
        "\n",
        "imagem = 5*x + 10*y\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "imagem\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Ao plotar imagens podemos escolher um mapa de cor e os pontos máximos e mínimos da coloração\n",
        "\n",
        "pl.imshow(imagem, cmap='terrain', vmin=5000, vmax=10000)\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Podemos adicionar a grade de valores também se desejarmos\n",
        "pl.imshow(imagem, cmap='terrain', vmin=5000, vmax=10000)\n",
        "pl.grid(True)\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# controlando o cmap\n",
        "pl.imshow(imagem, cmap='gray')\n",
        "pl.show()\n",
        "```\n",
        "\n",
        "**Agora podemos combinar os diferentes plots utilizando uma grade de plots**\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "# Importando o gridspec\n",
        "\n",
        "import matplotlib.gridspec as gridspec\n",
        "```\n",
        "\n",
        "```{pyodide}\n",
        "#| autorun: true\n",
        "fig = pl.figure(figsize=[10,5])\n",
        "\n",
        "gs = gridspec.GridSpec(2, 2) # Criando a nossa grade\n",
        "\n",
        "\n",
        "##############################################################################\n",
        "# Criando o primeiro plot na posição [0, 0]\n",
        "ax = fig.add_subplot(gs[0, 0])\n",
        "pl.imshow(imagem, cmap='terrain', vmin=5000, vmax=10000)\n",
        "pl.xticks([])\n",
        "\n",
        "##############################################################################\n",
        "# Criando o segundo plot na posição [0, 1]\n",
        "ax = fig.add_subplot(gs[0, 1])\n",
        "pl.imshow(imagem, cmap='terrain', vmin=5000, vmax=10000)\n",
        "pl.xticks([])\n",
        "\n",
        "##############################################################################\n",
        "# Criando o terceiro plot na posição [1, 1]\n",
        "ax = fig.add_subplot(gs[1, 1])\n",
        "pl.yticks([])\n",
        "pl.scatter(np.arange(10), 5*np.arange(10) + 10, s=a, c=2*a, cmap='cividis')\n",
        "pl.show()\n",
        "```\n",
