    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Ou de forma mais automática, podemos fazer\n",
        "\n",
        "a = 1 # Chute inicial\n",
        "b = 2 # Chute inicial\n",
        "x0 = (a + b)/2\n",
        "err = abs(b - a)\n",
        "\n",
        "while err > 0.001:\n",
        "    if (funcao(a) < 0) * (funcao(b) > 0) * (funcao(x0) > 0):\n",
        "        a = a\n",
        "        b = x0\n",
        "    if (funcao(a) < 0) * (funcao(b) > 0) * (funcao(x0) < 0):\n",
        "        a = x0\n",
        "        b = b\n",
        "    if (funcao(a) > 0) * (funcao(b) < 0) * (funcao(x0) < 0):\n",
        "        a = a\n",
        "        b = x0\n",
        "    if (funcao(a) > 0) * (funcao(b) < 0) * (funcao(x0) > 0):\n",
        "        a = x0\n",
        "        b = b\n",
        "\n",
        "    x0 = (a + b)/2\n",
        "    err = abs(b - a)\n",
        "    \n",
        "print(x0, err)"
