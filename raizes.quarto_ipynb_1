      "source": [
        "# $f(x) = \\sqrt{x} - 5e^{-x}$"
      ],
      "id": "de3a6048"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def func(x):\n",
        "    f = np.sqrt(x) - 5*(np.e**(-x))\n",
        "    return f"
      ],
      "id": "a081feea",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Avaliando o sinal de f(x), para x entre 0 e 10\n",
        "\n",
        "x = np.arange(10)\n",
        "\n",
        "for i in range(len(x)):\n",
        "    f = func(x[i])\n",
        "    if f < 0:\n",
        "        print(x[i], '-')\n",
        "    else:\n",
        "        print(x[i], '+')"
      ],
      "id": "bc7ba29e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "tags": []
      },
      "source": [
        "# Colocando este sinal em uma variavel\n",
        "\n",
        "x = np.arange(0,10, 1)\n",
        "sinal = np.array([]) #############################\n",
        "\n",
        "for i in range(len(x)):\n",
        "    f = np.sqrt(x[i]) - 5*(np.e**(-x[i]))\n",
        "    if f < 0:\n",
        "        sinal = np.append(sinal, -1) #############################\n",
        "        print(x[i], '-')\n",
        "    else:\n",
        "        sinal = np.append(sinal, +1) #############################\n",
        "        print(x[i], '+')"
      ],
      "id": "80ba9e65",
      "execution_count": null,
      "outputs": []
    },
    {
