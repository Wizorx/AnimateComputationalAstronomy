    "#| autorun: true\n",
    "```\n",
    "\n",
    "```{pyodide}\n",
    "#| autorun: true\n",
    "# a partir do quinto elemento\n",
    "print(a[5:])\n",
    "```\n",
    "\n",
    "```{pyodide}\n",
    "#| autorun: true\n",
